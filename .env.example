# 质量管理系统 —— 服务器环境变量模板
# 首次部署时 deploy.sh / server-bootstrap.sh 会自动复制为 .env
# 修改后执行：cd /opt/quality-board && docker compose up -d（无需重建镜像）
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库

# 运行环境
NODE_ENV=production
TZ=Asia/Shanghai

# 服务端口（容器内固定 3000，一般无需改）
PORT=3000

# 初始管理员账号（仅在数据库首次创建时生效；改库已存在后不生效）
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=请改成你的强密码

# 飞书数据同步（可选，不填则不启用）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# 数据与上传目录（容器内路径，对应宿主机 ./data 持久化卷，一般无需改）
# DB_PATH=/data/data.db
# UPLOAD_DIR=/data/uploads
# PRODUCT_IMAGES_DIR=/data/product-images
